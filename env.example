# ============================================================
#  .env.example  –  copy to .env and fill in
# ============================================================

# ── Spotify ─────────────────────────────────────────────────
# Needs to match the Redirect URI in the Spotify app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Needs to match the Redirect URI in the Spotify app
SPOTIFY_REDIRECT_URI=

# Gets automatically filled after `python sync_playlists.py --auth`
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=

# ── Tidal ────────────────────────────────────────────────────
# Create an app on https://developer.tidal.com/
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Needs to match the Redirect URI in the Tidal app
TIDAL_REDIRECT_URI=

# Gets automatically filled after `python sync_playlists.py --auth`
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_USER_ID=

# ISO 3166-1 alpha-2 landcode (bepaalt beschikbaarheid van tracks)
TIDAL_COUNTRY_CODE=NL
